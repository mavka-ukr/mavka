взяти визначення мавка/пристрій;
простір мавка {
  простір бібліотека {
    структура АргументСлухача {
      М: *Машина;
      прт_слухач: *Притриманий;
      прт_обробник_підключення: *Притриманий;
      прт_обробник_даних: *Притриманий;
      прт_обробник_стікання: *Притриманий;
      прт_обробник_засидження: *Притриманий;
      прт_обробник_помилки: *Притриманий;
      прт_обробник_відключення: *Притриманий;
      як_текст: логічне;
    }

    структура АргументКлієнтаСлухача {
      М: *Машина;
      прт_клієнт_слухача: *Притриманий;
    }

    дія обробник_знищення_клієнта_слухача(аргумент: адреса) {
      змінна акс = аргумент як *АргументКлієнтаСлухача;
      змінна М = акс.М;
      змінна предмет_клієнт_слухача = акс.прт_клієнт_слухача.предмет як *СкладенийПредмет;
      змінна кдкс = предмет_клієнт_слухача.користувацькі_дані.значення як *КористувацькіДаніІнетКлієнтаСлухача;

      кдкс.адр_клієнт_слухача = пусто;

      відпустити_притриманий_глобально(М, акс.прт_клієнт_слухача);

      звільнити(М, акс);
    }

    дія обробник_даних(розетка: адреса, дані: *п8, розмір: природне) {
      змінна ас = бібліотека_мавки_інет_отримати_аргумент_слухача_з_клієнта(розетка) як *АргументСлухача;
      змінна М = ас.М;
      змінна предмет_слухач = ас.прт_слухач.предмет;
      змінна предмет_обробник_даних: *Предмет = пусто;
      якщо ас.прт_обробник_даних != пусто {
        предмет_обробник_даних = ас.прт_обробник_даних.предмет;
      }

      якщо предмет_обробник_даних == пусто {
        звільнити(М, дані);
        вернути;
      }

      змінна акс = бібліотека_мавки_інет_отримати_аргумент_клієнта_слухача(розетка) як *АргументКлієнтаСлухача;
      змінна предмет_клієнт_слухача = акс.прт_клієнт_слухача.предмет;

      змінна кількість_задіяних = п32(3);
      змінна дані_задіяних = виділити<Значення>(М, природне(кількість_задіяних));

      дані_задіяних[0] = ПРЕДМЕТ(предмет_клієнт_слухача);
      якщо ас.як_текст {
        дані_задіяних[1] = ПРЕДМЕТ(створити_текст_без_копіювання(
          М,
          розмір,
          дані,
        ));
      } інакше {
        дані_задіяних[1] = ПРЕДМЕТ(створити_дані_без_копіювання(
          М,
          розмір,
          дані,
        ));
      }
      дані_задіяних[2] = ПРЕДМЕТ(предмет_слухач);

      змінна інформація_падіння: ІнформаціяПадіння;
      здійснити(
        М,
        НЕДІЙСНЕ,
        ПРЕДМЕТ(предмет_обробник_даних),
        Задіяні { ВидЗадіяних2, кількість_задіяних, дані_задіяних, 0 },
        МІСЦЕю8(М, ю8"вм://бібліотека/інет/слухати.ц", 0),
      );
      якщо отримати_інформацію_падіння(М, інформація_падіння::адреса) {
        якщо М.налаштування.обробник_падінь == пусто {
          ЗАПАНІКУВАТИ(М, "необроблене падіння!");
        } інакше {
          вимкнути_стан_падіння(М);

          М.налаштування.обробник_падінь(
            М,
            інформація_падіння
          );
        }
      }
    }

    дія перед_знищенням_кдкс(М: *Машина, користувацькі_дані: *КористувацькіДані) {
      надрукувати_кд(М, "перед_знищенням_кдкс");

      змінна кдкс = користувацькі_дані.значення як *КористувацькіДаніІнетКлієнтаСлухача;
      якщо кдкс.адр_клієнт_слухача != пусто {
        // потім: адр_клієнт_слухача не пусто
      }
      звільнити(М, кдкс);
    }

    дія перед_знищенням_кдс(М: *Машина, користувацькі_дані: *КористувацькіДані) {
      надрукувати_кд(М, "перед_знищенням_кдс");

      змінна кдкс = користувацькі_дані.значення як *КористувацькіДаніІнетСлухача;
      якщо кдкс.адр_слухач != пусто {
