          );
        }
      }
    }

    дія обробник_помилки(помилка: природне, аргумент_слухача: адреса) {
      змінна ас = аргумент_слухача як *АргументСлухача;
      змінна М = ас.М;
      змінна предмет_слухач = ас.прт_слухач.предмет;
      змінна предмет_обробник_помилки: *Предмет = пусто;

