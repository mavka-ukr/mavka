      змінна предмет_звʼязку = створити_складений_предмет(М, кдбм.інет__Звʼязок);
      змінна кдз = виділити<КористувацькіДаніІнетЗвʼязку>(М, 1);
      кдз.адр_звʼязок = адр_звʼязок;
      предмет_звʼязку.користувацькі_дані = створити_користувацькі_дані(М, кдз, перед_знищенням_кдз);

      змінна акс = виділити<АргументЗвʼязкуСлуги>(М, 1);
      акс.М = М;
      акс.прт_звʼязок = притримати_глобально(М, предмет_звʼязку як *Предмет);

      бібліотека_мавки_інет_записати_аргумент_звʼязку(
        адр_звʼязок,
        акс,
        обробник_знищення_звʼязку_слуги
      );

      якщо предмет_обробник_підключення == пусто {
        вернути;
      }

      змінна кількість_задіяних = п32(2);
      змінна дані_задіяних = виділити<Значення>(М, природне(кількість_задіяних));

      дані_задіяних[0] = ПРЕДМЕТ(предмет_звʼязку);
      дані_задіяних[1] = ПРЕДМЕТ(предмет_слуги);

      здійснити_предмет(
        М,
        предмет_обробник_підключення,
        кількість_задіяних,
        дані_задіяних,
      );
    }

    внутрішня дія обробник_даних(адр_слуга: адреса, адр_звʼязок: адреса, дані: *п8, розмір: природне) {
      змінна ас = бібліотека_мавки_інет_отримати_аргумент_слуги(адр_слуга) як *АргументСлуги;
      змінна М = ас.М;
      змінна предмет_слуги = ас.прт_слуга.предмет;
      змінна предмет_обробник_даних: *Предмет = пусто;

      якщо ас.прт_обробник_даних != пусто {
        предмет_обробник_даних = ас.прт_обробник_даних.предмет;
      }

      якщо предмет_обробник_даних == пусто {
        звільнити(М, дані);
        вернути;
      }

      змінна акс = бібліотека_мавки_інет_отримати_аргумент_звʼязку(адр_звʼязок) як *АргументЗвʼязкуСлуги;
      змінна предмет_звʼязку = акс.прт_звʼязок.предмет;

      змінна кількість_задіяних = п32(3);
      змінна дані_задіяних = виділити<Значення>(М, природне(кількість_задіяних));

      дані_задіяних[0] = ПРЕДМЕТ(предмет_звʼязку);
      якщо ас.як_текст {
        дані_задіяних[1] = ПРЕДМЕТ(створити_текст_без_копіювання(
          М,
          розмір,
          дані,
        ));
      } інакше {
        дані_задіяних[1] = ПРЕДМЕТ(створити_дані_без_копіювання(
          М,
          розмір,
          дані,
        ));
      }
      дані_задіяних[2] = ПРЕДМЕТ(предмет_слуги);

      здійснити_предмет(
        М,
        предмет_обробник_даних,
        кількість_задіяних,
        дані_задіяних,
      );
    }

