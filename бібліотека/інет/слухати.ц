      змінна предмет_слухач = ас.прт_слухач.предмет;
      змінна предмет_обробник_підключення = ас.прт_обробник_підключення.предмет;

      змінна кдбм = М.користувацькі_дані_бібліотеки.значення як *КористувацькіДаніБібліотекиМавки;

      змінна предмет_клієнт_слухача = створити_складений_предмет(М, кдбм.інет__КлієнтСлухача);
      змінна кдкс = виділити<КористувацькіДаніІнетКлієнтаСлухача>(М, 1);
      кдкс.адр_клієнт_слухача = адр_клієнт_слухача;
      предмет_клієнт_слухача.користувацькі_дані = створити_користувацькі_дані(М, кдкс, перед_знищенням_кдкс);

      змінна акс = виділити<АргументКлієнтаСлухача>(М, 1);
      акс.М = М;
      акс.прт_клієнт_слухача = притримати_глобально(М, предмет_клієнт_слухача як *Предмет);

      бібліотека_мавки_інет_записати_аргумент_клієнта_слухача(
        адр_клієнт_слухача,
        акс,
        обробник_знищення_клієнта_слухача
      );

      змінна кількість_задіяних = п32(2);
      змінна дані_задіяних = виділити<Значення>(М, природне(кількість_задіяних));

      дані_задіяних[0] = ПРЕДМЕТ(предмет_клієнт_слухача);
      дані_задіяних[1] = ПРЕДМЕТ(предмет_слухач);

      змінна інформація_падіння: ІнформаціяПадіння;
      здійснити(
        М,
        НЕДІЙСНЕ,
        ПРЕДМЕТ(предмет_обробник_підключення),
        Задіяні { ВидЗадіяних2, кількість_задіяних, дані_задіяних, 0 },
        МІСЦЕю8(М, ю8"вм://бібліотека/інет/слухати.ц", 0),
      );
      якщо отримати_інформацію_падіння(М, інформація_падіння::адреса) {
        якщо М.налаштування.обробник_падінь == пусто {
          ЗАПАНІКУВАТИ(М, "необроблене падіння!");
        } інакше {
          вимкнути_стан_падіння(М);

          М.налаштування.обробник_падінь(
            М,
            інформація_падіння
          );
        }
      }
    }

    дія обробник_відключення(адр_клієнт_слухача: адреса, помилка: природне) {
      змінна ас = бібліотека_мавки_інет_отримати_аргумент_слухача_з_клієнта(адр_клієнт_слухача) як *АргументСлухача;
      змінна акс = бібліотека_мавки_інет_отримати_аргумент_клієнта_слухача(адр_клієнт_слухача) як *АргументКлієнтаСлухача;
      змінна М = акс.М;
      змінна предмет_слухач = ас.прт_слухач.предмет;
      змінна предмет_клієнт_слухача = акс.прт_клієнт_слухача.предмет як *СкладенийПредмет;
      змінна кдкс = предмет_клієнт_слухача.користувацькі_дані.значення як *КористувацькіДаніІнетКлієнтаСлухача;
      змінна предмет_обробник_відключення: *Предмет = пусто;

      кдкс.адр_клієнт_слухача = пусто;

      якщо ас.прт_обробник_відключення != пусто {
        предмет_обробник_відключення = ас.прт_обробник_відключення.предмет;
