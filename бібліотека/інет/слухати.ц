    дія обробник_знищення(аргумент_слухача: адреса) {
      змінна ас = аргумент_слухача як *АргументСлухача;
      змінна М = ас.М;

      відпустити_притриманий_глобально(М, ас.прт_слухач);
      якщо ас.прт_обробник_підключення != пусто {
        відпустити_притриманий_глобально(М, ас.прт_обробник_підключення);
      }
      якщо ас.прт_обробник_даних != пусто {
        відпустити_притриманий_глобально(М, ас.прт_обробник_даних);
      }
      якщо ас.прт_обробник_стікання != пусто {
        відпустити_притриманий_глобально(М, ас.прт_обробник_стікання);
      }
      якщо ас.прт_обробник_засидження != пусто {
        відпустити_притриманий_глобально(М, ас.прт_обробник_засидження);
      }
      якщо ас.прт_обробник_помилки != пусто {
        відпустити_притриманий_глобально(М, ас.прт_обробник_помилки);
      }
      якщо ас.прт_обробник_відключення != пусто {
        відпустити_притриманий_глобально(М, ас.прт_обробник_відключення);
      }

      звільнити(М, ас);
    }

    внутрішня дія рідна_дія__слухати(
      М: *Машина,
      діяльність: *Діяльність
    ) -> ЗначенняАбоСтанПадіння {
      змінна задіяне_іа = НЕДІЙСНЕ;
      змінна знайдено_задіяне_іа = ні;
      змінна задіяне_порт = НЕДІЙСНЕ;
      змінна знайдено_задіяне_порт = ні;
      змінна задіяне_обробник_підключення = НЕДІЙСНЕ;
      змінна знайдено_задіяне_обробник_підключення = ні;
      змінна задіяне_обробник_даних = НЕДІЙСНЕ;
      змінна знайдено_задіяне_обробник_даних = ні;
      змінна задіяне_обробник_стікання = НЕДІЙСНЕ;
      змінна знайдено_задіяне_обробник_стікання = ні;
      змінна задіяне_обробник_засидження = НЕДІЙСНЕ;
      змінна знайдено_задіяне_обробник_засидження = ні;
      змінна задіяне_обробник_помилки = НЕДІЙСНЕ;
      змінна знайдено_задіяне_обробник_помилки = ні;
      змінна задіяне_обробник_відключення = НЕДІЙСНЕ;
      змінна знайдено_задіяне_обробник_відключення = ні;
      змінна задіяне_формат = НЕДІЙСНЕ;
