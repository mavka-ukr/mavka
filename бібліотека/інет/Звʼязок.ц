взяти визначення мавка/пристрій;

простір мавка {
  простір бібліотека {
    структура АргументНадсилання {
      М: *Машина;
      прт_значення: *Притриманий;
      прт_відклик: *Притриманий;
    }

    структура АргументЗакінчення {
      М: *Машина;
      прт_значення: *Притриманий;
      прт_відклик: *Притриманий;
    }

    внутрішня дія відклик_надсилання(адр_звʼязок: адреса, аргумент_надсилання: адреса, помилка: природне) {
      змінна ан = аргумент_надсилання як *АргументНадсилання;
      змінна М = ан.М;

      якщо помилка != 0 і ан.прт_відклик != пусто {
        // потім: обробити
      }

      якщо ан.прт_значення != пусто {
        відпустити_притриманий_глобально(М, ан.прт_значення);
      }
      якщо ан.прт_відклик != пусто {
        відпустити_притриманий_глобально(М, ан.прт_відклик);
      }

      звільнити(М, ан);
    }

    внутрішня дія відклик_закінчення(адр_звʼязок: адреса, аргумент_закінчення: адреса, помилка: природне) {
      змінна аз = аргумент_закінчення як *АргументЗакінчення;
      змінна М = аз.М;

      якщо помилка != 0 і аз.прт_відклик != пусто {
        // потім: обробити
      }

      якщо аз.прт_значення != пусто {
        відпустити_притриманий_глобально(М, аз.прт_значення);
      }
      якщо аз.прт_відклик != пусто {
        відпустити_притриманий_глобально(М, аз.прт_відклик);
      }

      звільнити(М, аз);
    }

    внутрішня дія рідна_дія_методу_структури_Звʼязок__надіслати(
      М: *Машина,
      діяльність: *Діяльність
    ) -> ЗначенняАбоСтанПадіння {
      змінна кдбм = М.користувацькі_дані_бібліотеки.значення як *КористувацькіДаніБібліотекиМавки;

      якщо діяльність.здійснювач.вид != ЗПредмет {
        вернути ПАДІННЯ(М, створити_текст(М, "Неможливо здійснити дію \"надіслати\"."));
      }

      змінна предмет_звʼязку = діяльність.здійснювач.дані як *Предмет як *СкладенийПредмет;

      якщо предмет_звʼязку.клас != кдбм.інет__Звʼязок {
        вернути ПАДІННЯ(М, створити_текст(М, "Неможливо здійснити дію \"надіслати\"."));
      }

      змінна задіяне_значення = НЕДІЙСНЕ;
      змінна знайдено_задіяне_значення = ні;
      змінна задіяне_відклик = НЕДІЙСНЕ;
      змінна знайдено_задіяне_відклик = ні;

      знайдено_задіяне_значення = знайти_задіяне(М, діяльність.задіяні, 0, М.константи_назв._значення, задіяне_значення::адреса);
      знайдено_задіяне_відклик = знайти_задіяне(М, діяльність.задіяні, 1, М.константи_назв._відклик, задіяне_відклик::адреса);

      змінна предмет_значення: *Предмет = пусто;
      змінна предмет_відклику: *Предмет = пусто;
      змінна має_власний_обробник_помилки = ні;
      змінна дані: *п8 = пусто;
      змінна розмір: природне = 0;

      якщо задіяне_значення.вид == ЗПредмет {
        предмет_значення = задіяне_значення.дані як *Предмет;

        якщо предмет_значення.клас == М.клас_Дані {
          змінна предмет_даних = предмет_значення як *ПредметДаних;

          дані = предмет_даних.дані;
          розмір = предмет_даних.розмір;
        } інакше якщо предмет_значення.клас == М.клас_Текст {
          змінна предмет_тексту = предмет_значення як *ПредметТексту;

          дані = предмет_тексту.значення.дані;
          розмір = предмет_тексту.значення.розмір;
        } інакше {
          вернути ПАДІННЯ(М, створити_текст(М, "Задіяне \"значення\" має бути даними або текстом."));
        }
      } інакше {
        вернути ПАДІННЯ(М, створити_текст(М, "Задіяне \"значення\" має бути даними або текстом."));
      }

      якщо знайдено_задіяне_відклик {
        якщо задіяне_відклик.вид == ЗПредмет {
          предмет_відклику = задіяне_відклик.дані як *Предмет;

          якщо предмет_відклику.клас != М.клас_Дія {
            вернути ПАДІННЯ(М, створити_текст(М, "Задіяне \"відклик\" має бути дією."));
          }

          має_власний_обробник_помилки = так;
        } інакше {
          вернути ПАДІННЯ(М, створити_текст(М, "Задіяне \"значення\" має бути дією."));
        }
      }

      якщо розмір == 0 {
        вернути ДІЙСНЕ;
      }

      змінна кдз = предмет_звʼязку.користувацькі_дані.значення як *КористувацькіДаніІнетЗвʼязку;
      якщо кдз.адр_звʼязок == пусто {
        // потім: ймовірно треба тригернути обробник_помилки
        вернути НЕДІЙСНЕ;
      }

      змінна ан = виділити<АргументНадсилання>(М, 1);
      ан.М = М;
      ан.прт_значення = притримати_глобально(М, предмет_значення);
      ан.прт_відклик = притримати_глобально(М, предмет_відклику);

      змінна результат = бібліотека_мавки_інет_звʼязок_надіслати(
        кдз.адр_звʼязок,
        дані,
        розмір,
        ан,
        відклик_надсилання,
        природне(має_власний_обробник_помилки),
      );

      вернути ЛОГЛОГ(результат);
    }

    внутрішня дія рідна_дія_методу_структури_Звʼязок__закінчити(
      М: *Машина,
      діяльність: *Діяльність
    ) -> ЗначенняАбоСтанПадіння {
      змінна кдбм = М.користувацькі_дані_бібліотеки.значення як *КористувацькіДаніБібліотекиМавки;

      якщо діяльність.здійснювач.вид != ЗПредмет {
        вернути ПАДІННЯ(М, створити_текст(М, "Неможливо здійснити дію \"закінчити\"."));
      }

      змінна предмет_звʼязку = діяльність.здійснювач.дані як *Предмет як *СкладенийПредмет;

      якщо предмет_звʼязку.клас != кдбм.інет__Звʼязок {
        вернути ПАДІННЯ(М, створити_текст(М, "Неможливо здійснити дію \"закінчити\"."));
      }

      змінна задіяне_значення = НЕДІЙСНЕ;
      змінна знайдено_задіяне_значення = ні;
      змінна задіяне_відклик = НЕДІЙСНЕ;
      змінна знайдено_задіяне_відклик = ні;

      знайдено_задіяне_значення = знайти_задіяне(М, діяльність.задіяні, 0, М.константи_назв._значення, задіяне_значення::адреса);
      знайдено_задіяне_відклик = знайти_задіяне(М, діяльність.задіяні, 1, М.константи_назв._відклик, задіяне_відклик::адреса);

      змінна предмет_значення: *Предмет = пусто;
      змінна предмет_відклику: *Предмет = пусто;
      змінна має_власний_обробник_помилки = ні;
      змінна дані: *п8 = пусто;
      змінна розмір: природне = 0;

      якщо знайдено_задіяне_значення {
        якщо задіяне_значення.вид == ЗНедійсне {
        } інакше якщо задіяне_значення.вид == ЗПредмет {
          предмет_значення = задіяне_значення.дані як *Предмет;

          якщо предмет_значення.клас == М.клас_Дані {
            змінна предмет_даних = предмет_значення як *ПредметДаних;

            дані = предмет_даних.дані;
            розмір = предмет_даних.розмір;
          } інакше якщо предмет_значення.клас == М.клас_Текст {
            змінна предмет_тексту = предмет_значення як *ПредметТексту;

            дані = предмет_тексту.значення.дані;
            розмір = предмет_тексту.значення.розмір;
          } інакше {
            вернути ПАДІННЯ(М, створити_текст(М, "Задіяне \"значення\" має бути даними або текстом."));
          }
        } інакше {
          вернути ПАДІННЯ(М, створити_текст(М, "Задіяне \"значення\" має бути даними або текстом."));
        }
      }

      якщо знайдено_задіяне_відклик {
        якщо задіяне_відклик.вид == ЗПредмет {
          предмет_відклику = задіяне_відклик.дані як *Предмет;

          якщо предмет_відклику.клас != М.клас_Дія {
            вернути ПАДІННЯ(М, створити_текст(М, "Задіяне \"відклик\" має бути дією."));
          }

          має_власний_обробник_помилки = так;
        } інакше {
          вернути ПАДІННЯ(М, створити_текст(М, "Задіяне \"значення\" має бути дією."));
        }
      }

      якщо розмір == 0 {
        вернути НЕДІЙСНЕ;
      }

      змінна кдз = предмет_звʼязку.користувацькі_дані.значення як *КористувацькіДаніІнетЗвʼязку;
      якщо кдз.адр_звʼязок == пусто {
        // потім: ймовірно треба тригернути обробник_помилки
        вернути НЕДІЙСНЕ;
      }

      змінна ан = виділити<АргументЗакінчення>(М, 1);
      ан.М = М;
      ан.прт_значення = притримати_глобально(М, предмет_значення);
      ан.прт_відклик = притримати_глобально(М, предмет_відклику);

      бібліотека_мавки_інет_звʼязок_закінчити(
        кдз.адр_звʼязок,
        дані,
        розмір,
        ан,
        відклик_надсилання,
        природне(має_власний_обробник_помилки),
      );

      вернути НЕДІЙСНЕ;
    }

    внутрішня дія рідна_дія_методу_структури_Звʼязок__знищити(
      М: *Машина,
      діяльність: *Діяльність
    ) -> ЗначенняАбоСтанПадіння {
      змінна кдбм = М.користувацькі_дані_бібліотеки.значення як *КористувацькіДаніБібліотекиМавки;

      якщо діяльність.здійснювач.вид != ЗПредмет {
        вернути ПАДІННЯ(М, створити_текст(М, "Неможливо здійснити дію \"закінчити\"."));
      }

      змінна предмет_звʼязку = діяльність.здійснювач.дані як *Предмет як *СкладенийПредмет;

      якщо предмет_звʼязку.клас != кдбм.інет__Звʼязок {
        вернути ПАДІННЯ(М, створити_текст(М, "Неможливо здійснити дію \"закінчити\"."));
      }

      змінна кдз = предмет_звʼязку.користувацькі_дані.значення як *КористувацькіДаніІнетЗвʼязку;
      якщо кдз.адр_звʼязок == пусто {
        // потім: ймовірно треба тригернути обробник_помилки
        вернути НЕДІЙСНЕ;
      }

      бібліотека_мавки_інет_звʼязок_знищити(
        кдз.адр_звʼязок
      );

      вернути НЕДІЙСНЕ;
    }

    внутрішня дія записати_метод_класу_Звʼязок__надіслати(
      М: *Машина,
      клас: *ПредметКласу
    ) {
      змінна предмет_дії = створити_рідну_дію(
        М,
        М.константи_назв._надіслати,
        М.пуста_послідовність,
        пусто,
        рідна_дія_методу_структури_Звʼязок__надіслати,
        пусто
      );

      записати_метод_класу(
        М,
        клас,
        М.константи_назв._надіслати,
        предмет_дії
      );

      якщо М.стан_падіння {
        ЗАПАНІКУВАТИ(М, "Помилка при записі методу \"надіслати\" для класу \"Звʼязок\".");
      }
    }

    внутрішня дія записати_метод_класу_Звʼязок__закінчити(
      М: *Машина,
      клас: *ПредметКласу
    ) {
      змінна предмет_дії = створити_рідну_дію(
        М,
        М.константи_назв._закінчити,
        М.пуста_послідовність,
        пусто,
        рідна_дія_методу_структури_Звʼязок__закінчити,
        пусто
      );

      записати_метод_класу(
        М,
        клас,
        М.константи_назв._закінчити,
        предмет_дії
      );

      якщо М.стан_падіння {
        ЗАПАНІКУВАТИ(М, "Помилка при записі методу \"закінчити\" для класу \"Звʼязок\".");
      }
    }

    внутрішня дія записати_метод_класу_Звʼязок__знищити(
      М: *Машина,
      клас: *ПредметКласу
    ) {
      змінна предмет_дії = створити_рідну_дію(
        М,
        М.константи_назв._знищити,
        М.пуста_послідовність,
        пусто,
        рідна_дія_методу_структури_Звʼязок__знищити,
        пусто
      );

      записати_метод_класу(
        М,
        клас,
        М.константи_назв._знищити,
        предмет_дії
      );

      якщо М.стан_падіння {
        ЗАПАНІКУВАТИ(М, "Помилка при записі методу \"знищити\" для класу \"Звʼязок\".");
      }
    }

    дія записати_клас__інет__Звʼязок(
      М: *Машина,
      предмет_модуля: *ПредметМодуля
    ) {
      змінна кдбм = М.користувацькі_дані_бібліотеки.значення як *КористувацькіДаніБібліотекиМавки;

      кдбм.інет__Звʼязок = створити_клас(
        М,
        М.константи_назв._Звʼязок,
        М.пуста_послідовність
      );

      записати_метод_класу_Звʼязок__надіслати(М, кдбм.інет__Звʼязок);
      записати_метод_класу_Звʼязок__закінчити(М, кдбм.інет__Звʼязок);
      записати_метод_класу_Звʼязок__знищити(М, кдбм.інет__Звʼязок);

      записати_властивість_модуля(
        М,
        предмет_модуля,
        М.константи_назв._Звʼязок,
        ПРЕДМЕТ(кдбм.інет__Звʼязок)
      );
    }
  }
}