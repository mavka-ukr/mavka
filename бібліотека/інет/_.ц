взяти визначення мавка/бібліотека;
взяти визначення мавка/пристрій;

простір мавка {
  простір бібліотека {
    дія отримати_текст_інет_помилки(М: *Машина, помилка: природне) -> *ПредметТексту {
      змінна значення = "";

      якщо помилка == МАВКА_ІНЕТ_УСПІХ {
        значення = "Успіх!";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_НЕВІДОМА {
        значення = "Невідома помилка.";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_НЕДОСТАТНЬО_ПАМʼЯТІ {
        значення = "Недостатньо памʼяті.";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_АРГУМЕНТУ {
        значення = "ПОМИЛКА_АРГУМЕНТУ";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_АДРЕСА_ВИКОРИСТОВУЄТЬСЯ {
        значення = "Адреса використовується.";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_ЗʼЄДНАННЯ_ВІДХИЛЕНО {
        значення = "Зʼєднання відхилено.";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_ЗʼЄДНАННЯ_СКИНОТО {
        значення = "Зʼєднання скинуто.";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_МЕРЕЖА_НЕДОСТУПНА {
        значення = "Мережа недоступна.";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_ХОСТ_НЕДОСТУПНИЙ {
        значення = "Хост недоступний.";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_ТАЙМАУТ {
        значення = "Час вийшов.";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_КАНАЛ_ЗЛАМАНО {
        значення = "Канал зламано.";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_ДОСТУПУ {
        значення = "Помилка доступу.";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_ЗАБАГАТО_ФАЙЛІВ {
        значення = "Забагато файлів.";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_АДРЕСА_НЕДОСТУПНА {
        значення = "Адреса недоступна.";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_ПЕРЕПОВНЕННЯ_БУФЕРА {
        значення = "Переповнення буфера.";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_МЕРЕЖА_ВІДМОВИЛА {
        значення = "Мережа відмовила.";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_МЕРЕЖА_СКИНУТА {
        значення = "Мережа скинута.";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_ЗʼЄДНАННЯ_ПЕРЕРВАНО {
        значення = "Зʼєднання перерваною";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_ВЖЕ_ПІДДОСЛІДЖЕНО {
        значення = "ВЖЕ_ПІДДОСЛІДЖЕНО";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_НЕ_ПІДʼЄДНАНО {
        значення = "Не підʼєднано.";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_ВХІД_ВИХІД {
        значення = "ВХІД_ВИХІД";
      } інакше якщо помилка == МАВКА_ІНЕТ_ПОМИЛКА_НЕПРАВИЛЬНИЙ_ФАЙЛ {
        значення = "Неправильний файл.";
      } інакше {
        значення = "Невідома помилка.";
      }

      вернути створити_текст(М, значення);
    }

    дія ініціалізувати__інет(
      М: *Машина,
      предмет_модуля: *ПредметМодуля
    ) {
      записати_клас__інет__Слуга(М, предмет_модуля);
      записати_клас__інет__Звʼязок(М, предмет_модуля);
      записати_дію__інет__служити(М, предмет_модуля);
      записати_дію__інет__підключитись(М, предмет_модуля);
    }
  }
}