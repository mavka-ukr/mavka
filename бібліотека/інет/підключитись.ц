        вернути ПАДІННЯ(М, створити_текст(М, "Задіяне \"обробник_стікання\" має бути дією!"));
      }

      якщо не знайдено_задіяне_обробник_закінчення {
        предмет_обробник_закінчення = пусто;
      } інакше якщо задіяне_обробник_закінчення.вид == ЗПредмет {
        предмет_обробник_закінчення = задіяне_обробник_закінчення.дані як *Предмет;

        якщо предмет_обробник_закінчення.клас != М.клас_Дія {
          вернути ПАДІННЯ(М, створити_текст(М, "Задіяне \"обробник_закінчення\" має бути дією!"));
        }
      } інакше {
        вернути ПАДІННЯ(М, створити_текст(М, "Задіяне \"обробник_закінчення\" має бути дією!"));
      }

      якщо не знайдено_задіяне_обробник_помилки {
        предмет_обробник_помилки = пусто;
      } інакше якщо задіяне_обробник_помилки.вид == ЗПредмет {
        предмет_обробник_помилки = задіяне_обробник_помилки.дані як *Предмет;

        якщо предмет_обробник_помилки.клас != М.клас_Дія {
          вернути ПАДІННЯ(М, створити_текст(М, "Задіяне \"обробник_помилки\" має бути дією!"));
        }
      } інакше {
        вернути ПАДІННЯ(М, створити_текст(М, "Задіяне \"обробник_помилки\" має бути дією!"));
      }

      якщо не знайдено_задіяне_обробник_відключення {
        предмет_обробник_відключення = пусто;
      } інакше якщо задіяне_обробник_відключення.вид == ЗПредмет {
        предмет_обробник_відключення = задіяне_обробник_відключення.дані як *Предмет;

        якщо предмет_обробник_відключення.клас != М.клас_Дія {
          вернути ПАДІННЯ(М, створити_текст(М, "Задіяне \"обробник_відключення\" має бути дією!"));
        }
      } інакше {
        вернути ПАДІННЯ(М, створити_текст(М, "Задіяне \"обробник_відключення\" має бути дією!"));
      }

      змінна ап = виділити_аргумент_інет_звʼязку(М);
      ап.М = М;
      ап.як_текст = як_текст;
      якщо предмет_обробник_підключення != пусто {
        ап.прт_обробник_підключення = притримати_глобально(М, предмет_обробник_підключення);
      }
      якщо предмет_обробник_даних != пусто {
        ап.прт_обробник_даних = притримати_глобально(М, предмет_обробник_даних);
      }
      якщо предмет_обробник_стікання != пусто {
        ап.прт_обробник_стікання = притримати_глобально(М, предмет_обробник_стікання);
      }
      якщо предмет_обробник_закінчення != пусто {
        ап.прт_обробник_закінчення = притримати_глобально(М, предмет_обробник_закінчення);
      }
      якщо предмет_обробник_помилки != пусто {
        ап.прт_обробник_помилки = притримати_глобально(М, предмет_обробник_помилки);
      }
      якщо предмет_обробник_відключення != пусто {
        ап.прт_обробник_відключення = притримати_глобально(М, предмет_обробник_відключення);
      }

      бібліотека_мавки_інет_підключитись(
        іа,
        порт,
        обробник_підключення,
        обробник_даних,
        обробник_стікання,
        обробник_закінчення,
        обробник_помилки,
        обробник_відключення,
        ап,
        обробник_знищення_інет_звʼязку,
      );

      вернути НЕДІЙСНЕ;
    }

    дія записати_дію__інет__підключитись(
      М: *Машина,
      предмет_модуля: *ПредметМодуля
    ) {
      змінна кількість_параметрів = природне(9);
      змінна дані_параметрів = виділити<Значення>(М, кількість_параметрів);

      дані_параметрів[0] = ПРЕДМЕТ(створити_параметр(
        М,
        М.константи_назв._іа,
        пусто,
        НЕДІЙСНЕ
      ));
      дані_параметрів[1] = ПРЕДМЕТ(створити_параметр(
        М,
        М.константи_назв._порт,
        пусто,
        НЕДІЙСНЕ
      ));
      дані_параметрів[2] = ПРЕДМЕТ(створити_параметр(
        М,
        М.константи_назв._формат,
        пусто,
        НЕДІЙСНЕ
      ));
      дані_параметрів[3] = ПРЕДМЕТ(створити_параметр(
        М,
        М.константи_назв._обробник_підключення,
        пусто,
        НЕДІЙСНЕ
      ));
      дані_параметрів[4] = ПРЕДМЕТ(створити_параметр(
        М,
        М.константи_назв._обробник_даних,
        пусто,
        НЕДІЙСНЕ
      ));
      дані_параметрів[5] = ПРЕДМЕТ(створити_параметр(
        М,
        М.константи_назв._обробник_стікання,
        пусто,
        НЕДІЙСНЕ
      ));
      дані_параметрів[6] = ПРЕДМЕТ(створити_параметр(
        М,
        М.константи_назв._обробник_закінчення,
        пусто,
        НЕДІЙСНЕ
      ));
      дані_параметрів[7] = ПРЕДМЕТ(створити_параметр(
        М,
        М.константи_назв._обробник_помилки,
        пусто,
        НЕДІЙСНЕ
      ));
      дані_параметрів[8] = ПРЕДМЕТ(створити_параметр(
        М,
        М.константи_назв._обробник_відключення,
        пусто,
        НЕДІЙСНЕ
      ));

      змінна д = створити_рідну_дію(
        М,
        М.константи_назв._підключитись,
        створити_послідовність_без_копіювання(
          М,
          кількість_параметрів,
          дані_параметрів
        ),
        пусто,
        рідна_дія__підключитись,
        пусто
      );

      записати_властивість_модуля(
        М,
        предмет_модуля,
        М.константи_назв._підключитись,
        ПРЕДМЕТ(д)
      );
    }
