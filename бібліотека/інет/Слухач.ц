взяти визначення мавка/бібліотека;
взяти визначення мавка/пристрій;

простір мавка {
  простір бібліотека {
    структура АргументНадсилання {
      М: *Машина;
      притриманий: *Притриманий;
    }

    внутрішня дія відклик_надсилання(помилка: природне, аргумент: адреса) {
      змінна ан = аргумент як *АргументНадсилання;
      змінна М = ан.М;

      відпустити_притриманий_глобально(М, ан.притриманий);

      звільнити(М, ан);
    }

    внутрішня дія рідна_дія_методу_структури_Слухач__зупинити(
      М: *Машина,
      діяльність: *Діяльність
    ) -> ЗначенняАбоСтанПадіння {
      змінна кдбм = М.користувацькі_дані_бібліотеки.значення як *КористувацькіДаніБібліотекиМавки;

      якщо діяльність.здійснювач.вид != ЗПредмет {
        вернути ПАДІННЯ(М, створити_текст(М, "Неможливо здійснити метод \"зупинити\"."));
      }

      змінна предмет_слухача = діяльність.здійснювач.дані як *Предмет як *СкладенийПредмет;

      якщо предмет_слухача.клас != кдбм.інет__Слухач {
        вернути ПАДІННЯ(М, створити_текст(М, "Неможливо здійснити дію \"зупинити\"."));
      }

      змінна задіяне_закрити_підключення = НЕДІЙСНЕ;
      змінна знайдено_задіяне_закрити_підключення = ні;

      знайдено_задіяне_закрити_підключення = знайти_задіяне(М, діяльність.задіяні, 0, М.константи_назв._закрити_підключення, задіяне_закрити_підключення::адреса);

      змінна кдс = предмет_слухача.користувацькі_дані.значення як *КористувацькіДаніІнетСлухача;
      якщо кдс.адр_слухач == пусто {
        вернути НЕДІЙСНЕ;
      }

      бібліотека_мавки_інет_зупинити_слухача(
        кдс.адр_слухач,
        природне(ЧИ(задіяне_закрити_підключення)),
      );

      вернути ДІЙСНЕ;
    }

    внутрішня дія записати_метод_класу_Слухач__зупинити(
      М: *Машина,
      клас: *ПредметКласу
    ) {
      змінна предмет_дії = створити_рідну_дію(
        М,
        М.константи_назв._зупинити,
        М.пуста_послідовність,
        пусто,
        рідна_дія_методу_структури_Слухач__зупинити,
        пусто
      );

      записати_метод_класу(
        М,
        клас,
        М.константи_назв._зупинити,
        предмет_дії
      );

      якщо М.стан_падіння {
        ЗАПАНІКУВАТИ(М, "Помилка при записі методу \"зупинити\" для класу \"Слухач\".");
      }
    }

    дія записати_клас__інет__Слухач(
      М: *Машина,
      предмет_модуля: *ПредметМодуля
    ) {
      змінна кдбм = М.користувацькі_дані_бібліотеки.значення як *КористувацькіДаніБібліотекиМавки;

      кдбм.інет__Слухач = створити_клас(
        М,
        М.константи_назв._Слухач,
        М.пуста_послідовність
      );

      записати_метод_класу_Слухач__зупинити(М, кдбм.інет__Слухач);

      записати_властивість_модуля(
        М,
        предмет_модуля,
        М.константи_назв._Слухач,
        ПРЕДМЕТ(кдбм.інет__Слухач)
      );
    }
  }
}