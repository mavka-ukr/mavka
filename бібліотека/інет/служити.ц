        пусто,
        НЕДІЙСНЕ
      ));
      дані_параметрів[3] = ПРЕДМЕТ(створити_параметр(
        М,
        М.константи_назв._обробник_запуску,
        пусто,
        НЕДІЙСНЕ
      ));
      дані_параметрів[4] = ПРЕДМЕТ(створити_параметр(
