      ));
      дані_параметрів[9] = ПРЕДМЕТ(створити_параметр(
        М,
        М.константи_назв._обробник_закінчення_звʼязку,
        пусто,
        НЕДІЙСНЕ
      ));
      дані_параметрів[10] = ПРЕДМЕТ(створити_параметр(
        М,
        М.константи_назв._обробник_помилки_звʼязку,
        пусто,
        НЕДІЙСНЕ
      ));
      дані_параметрів[11] = ПРЕДМЕТ(створити_параметр(
        М,
        М.константи_назв._обробник_відключення_звʼязку,
        пусто,
        НЕДІЙСНЕ
      ));

      змінна д = створити_рідну_дію(
        М,
        М.константи_назв._служити,
        створити_послідовність_без_копіювання(
          М,
          кількість_параметрів,
          дані_параметрів
        ),
        пусто,
        рідна_дія__служити,
        пусто
      );

      записати_властивість_модуля(
        М,
        предмет_модуля,
        М.константи_назв._служити,
        ПРЕДМЕТ(д)
      );
    }
