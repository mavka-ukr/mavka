    внутрішня дія обробник_підключення(адр_слуга: адреса, адр_звʼязок: адреса) {
      змінна ас = бібліотека_мавки_інет_отримати_аргумент_слуги_зі_звʼязку(адр_звʼязок) як *АргументСлуги;
      змінна М = ас.М;
      змінна предмет_слуга = ас.прт_слуга.предмет;
      змінна предмет_обробник_підключення: *Предмет = пусто;

      якщо ас.прт_обробник_підключення != пусто {
        предмет_обробник_підключення = ас.прт_обробник_підключення.предмет;
      }

      змінна кдбм = М.користувацькі_дані_бібліотеки.значення як *КористувацькіДаніБібліотекиМавки;

      змінна предмет_звʼязок = створити_складений_предмет(М, кдбм.інет__Звʼязок);
      змінна кдкс = виділити<КористувацькіДаніІнетЗвʼязку>(М, 1);
      кдкс.адр_звʼязок = адр_звʼязок;
      предмет_звʼязок.користувацькі_дані = створити_користувацькі_дані(М, кдкс, перед_знищенням_кдкс);

      змінна акс = виділити<АргументКлієнтаСлуги>(М, 1);
      акс.М = М;
      акс.прт_звʼязок = притримати_глобально(М, предмет_звʼязок як *Предмет);

      бібліотека_мавки_інет_записати_аргумент_звʼязку(
        адр_звʼязок,
        акс,
        обробник_знищення_клієнта_слуги
      );

      якщо предмет_обробник_підключення == пусто {
        вернути;
      }

      змінна кількість_задіяних = п32(2);
      змінна дані_задіяних = виділити<Значення>(М, природне(кількість_задіяних));

      дані_задіяних[0] = ПРЕДМЕТ(предмет_звʼязок);
      дані_задіяних[1] = ПРЕДМЕТ(предмет_слуга);

      змінна інформація_падіння: ІнформаціяПадіння;
      здійснити(
        М,
        НЕДІЙСНЕ,
        ПРЕДМЕТ(предмет_обробник_підключення),
        Задіяні { ВидЗадіяних2, кількість_задіяних, дані_задіяних, 0 },
        МІСЦЕю8(М, ю8"вм://бібліотека/інет/служити.ц", 0),
      );
      якщо отримати_інформацію_падіння(М, інформація_падіння::адреса) {
        якщо М.налаштування.обробник_падінь == пусто {
          ЗАПАНІКУВАТИ(М, "необроблене падіння!");
        } інакше {
          вимкнути_стан_падіння(М);

          М.налаштування.обробник_падінь(
            М,
            інформація_падіння
          );
        }
      }
    }

