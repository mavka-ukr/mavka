взяти визначення мавка/бібліотека;
взяти визначення мавка/пристрій;

простір мавка {
  простір бібліотека {
    структура АргументНадсилання {
      М: *Машина;
      притриманий: *Притриманий;
    }

    внутрішня дія відклик_надсилання(помилка: природне, аргумент_клієнта: адреса) {
      змінна ан = аргумент_клієнта як *АргументНадсилання;
      змінна М = ан.М;

      відпустити_притриманий_глобально(М, ан.притриманий);

      звільнити(М, ан);
    }

    внутрішня дія рідна_дія_методу_структури_Клієнт__надіслати(
      М: *Машина,
      діяльність: *Діяльність
    ) -> ЗначенняАбоСтанПадіння {
      змінна кдбм = М.користувацькі_дані_бібліотеки.значення як *КористувацькіДаніБібліотекиМавки;

      якщо діяльність.здійснювач.вид != ЗПредмет {
        вернути ПАДІННЯ(М, створити_текст(М, "Неможливо здійснити метод \"надіслати\"."));
      }

      змінна предмет_клієнта = діяльність.здійснювач.дані як *Предмет як *СкладенийПредмет;

      якщо предмет_клієнта.клас != кдбм.інет__Клієнт {
        вернути ПАДІННЯ(М, створити_текст(М, "Неможливо здійснити дію \"надіслати\"."));
      }

      змінна задіяне_значення = НЕДІЙСНЕ;
      змінна знайдено_задіяне_значення = ні;

      знайдено_задіяне_значення = знайти_задіяне(М, діяльність.задіяні, 0, М.константи_назв._значення, задіяне_значення::адреса);

      якщо задіяне_значення.вид != ЗПредмет {
        вернути ПАДІННЯ(М, створити_текст(М, "Задіяне \"значення\" має бути даними або текстом."));
      }

      змінна дані: *п8;
      змінна розмір: природне;

      змінна предмет_значення = задіяне_значення.дані як *Предмет;

      якщо предмет_значення.клас == М.клас_Дані {
        змінна предмет_даних = предмет_значення як *ПредметДаних;

        дані = предмет_даних.дані;
        розмір = предмет_даних.розмір;
      } інакше якщо предмет_значення.клас == М.клас_Текст {
        змінна предмет_тексту = предмет_значення як *ПредметТексту;

        дані = предмет_тексту.значення.дані;
        розмір = предмет_тексту.значення.розмір;
      } інакше {
        вернути ПАДІННЯ(М, створити_текст(М, "Задіяне \"значення\" має бути даними або текстом."));
      }

      якщо розмір == 0 {
        вернути ДІЙСНЕ;
      }

      змінна кдкс = предмет_клієнта.користувацькі_дані.значення як *КористувацькіДаніІнетКлієнт;
      якщо кдкс.адр_клієнт == пусто {
        вернути НЕДІЙСНЕ;
      }

      змінна ан = виділити<АргументНадсилання>(М, 1);
      ан.М = М;
      ан.притриманий = притримати_глобально(М, предмет_значення);

      змінна результат = бібліотека_мавки_інет_клієнт_надіслати(
        кдкс.адр_клієнт,
        дані,
        розмір,
        ан,
        відклик_надсилання,
      );

      якщо результат != 0 {
        вернути НЕДІЙСНЕ;
      }

      вернути ДІЙСНЕ;
    }

    внутрішня дія записати_метод_класу_Клієнт__надіслати(
      М: *Машина,
      клас: *ПредметКласу
    ) {
      змінна предмет_дії = створити_рідну_дію(
        М,
        М.константи_назв._надіслати,
        М.пуста_послідовність,
        пусто,
        рідна_дія_методу_структури_Клієнт__надіслати,
        пусто
      );

      записати_метод_класу(
        М,
        клас,
        М.константи_назв._надіслати,
        предмет_дії
      );

      якщо М.стан_падіння {
        ЗАПАНІКУВАТИ(М, "Помилка при записі методу \"надіслати\" для класу \"Клієнт\".");
      }
    }

    дія записати_клас__інет__Клієнт(
      М: *Машина,
      предмет_модуля: *ПредметМодуля
    ) {
      змінна кдбм = М.користувацькі_дані_бібліотеки.значення як *КористувацькіДаніБібліотекиМавки;

      кдбм.інет__Клієнт = створити_клас(
        М,
        М.константи_назв._Клієнт,
        М.пуста_послідовність
      );

      записати_метод_класу_Клієнт__надіслати(М, кдбм.інет__Клієнт);

      записати_властивість_модуля(
        М,
        предмет_модуля,
        М.константи_назв._Клієнт,
        ПРЕДМЕТ(кдбм.інет__Клієнт)
      );
    }
  }
}