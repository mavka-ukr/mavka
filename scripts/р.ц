взяти визначення РМв1;

внутрішня дія цикл_подій(Р: *РМв1::Розширення) -> ціле {
  Р.надрукувати_кд("привітики я в циклі подій!");

  вернути 0;
}

внутрішня дія взяти_біб(Р: *РМв1::Розширення, довжина_шляху: природне, елементи_шляху: *кд, рез: *РМв1::Значення) -> логічне {
  Р.надрукувати_кд("привітики я беру ціль!");

  вернути ні;
}

дія завантажити_РМв1_бібліотеки_мавки(
  Р: *РМв1::Розширення,
  рез: *РМв1::Значення,
) -> логічне {
  Р.надрукувати_кд("привітики я тута!");

  Р.встановити_цикл_подій(цикл_подій);
  Р.встановити_взяти_біб(взяти_біб);

  вернути так;
}