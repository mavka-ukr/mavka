взяти визначення мавка;

простір мавка {
  структура АргументПрочитаного {
    розмова: *Розмова;
    перед: кд;
    обробник: (значення: кд, кінець_файлу: логічне, помилка: природне, позиція_помилки: природне, аргумент: адреса) -> ніщо;
  }

  внутрішня дія обробник_прочитання(
    значення: кд,
    кінець_файлу: логічне,
    аргумент: адреса,
  ) {
    змінна ап = аргумент як *АргументПрочитаного;
    змінна розмова = ап.розмова;
    змінна М = розмова.М;

    якщо кінець_файлу {
      ап.обробник(
        кд { пусто, 0 },
        так,
        0,
        0,
        розмова
      );
    } інакше {
      ап.обробник(
        значення,
        ні,
        0,
        0,
        розмова
      );
    }

    // звільнити(М, значення.дані);
    звільнити(М, ап.перед.дані);
    звільнити(М, ап);
  }

  внутрішня дія розмова_читати(
    М: *Машина,
    перед: кд,
    дозволити_історію: логічне,
    обробник: (значення: кд, кінець_файлу: логічне, помилка: природне, позиція_помилки: природне, аргумент: адреса) -> ніщо,
    аргумент: адреса,
  ) -> логічне {
    змінна ап = виділити<АргументПрочитаного>(М, 1);
    ап.розмова = аргумент як *Розмова;
    ап.перед = перед;
    ап.обробник = обробник;

    читати_ввід_асинхронно(
      М,
      перед,
      обробник_прочитання,
      ап,
      дозволити_історію
    );

    вернути так;
  }

  внутрішня дія розмова_обробити_значення(
    М: *Машина,
    значення: Значення,
  ) {
    надрукувати_значення(
      М,
      значення,
      2,
      0
    );
  }

  внутрішня дія розмова_обробити_падіння(
    М: *Машина,
    інформація_падіння: ІнформаціяПадіння,
  ) {
    надрукувати_інформацію_падіння(
      М,
      інформація_падіння
    );
  }

  дія почати(
    М: *Машина,
    кількість_аргументів: природне,
    аргументи: **ПредметТексту,
  ) -> ціле {
    змінна успіх: логічне;
    змінна статус_помилки: ціле;
    змінна п: природне;
    змінна шлях_до_файлу: *ПредметТексту;
    змінна абсолютний_шлях_до_файлу_модуля: *ПредметТексту;
    змінна назва_модуля: *ПредметТексту;
    змінна інформація_падіння: ІнформаціяПадіння;

    п = 1;
    шлях_до_файлу = пусто;
    поки п < кількість_аргументів {
      якщо аргументи[п].значення.поч_з("-") {
      } інакше {
        шлях_до_файлу = аргументи[п];
        стрибнути х;
      }

      п += 1;
    }

  х:
    якщо шлях_до_файлу == пусто {
      М.шлях_до_теки_модулів = отримати_поточний_шлях_процесу(М);
      якщо М.шлях_до_теки_модулів == пусто {
        надрукувати_кд(М, "Неможливо отримати поточний шлях процесу.");
        вернути 1;
      }

      М.шлях_до_теки_паків = отримати_теку_до_паків(
        М,
        М.шлях_до_теки_модулів,
      );
      якщо М.шлях_до_теки_паків == пусто {
        надрукувати_кд(М, "Неможливо отримати теку до паків.");
        вернути 1;
      }

      вивести_кд(М, "Розмова Мавки ");
      надрукувати_кд(М, М.версія.предмет_тексту.значення);

      почати_розмову(
        М,
        створити_текст(М, "розмова"),
        розмова_читати,
        розмова_обробити_значення,
        розмова_обробити_падіння
      );
    } інакше {
      // потім: розібрати команди

      успіх = розібрати_шлях_початкового_модуля(
        М,
        шлях_до_файлу,
        абсолютний_шлях_до_файлу_модуля::адреса,
        М.шлях_до_теки_модулів::адреса,
        М.шлях_до_теки_паків::адреса,
        назва_модуля::адреса
      );
      якщо не успіх {
        вивести_кд(М, "Неможливо виконати файл \"");
        вивести_кд(М, шлях_до_файлу.значення);
        вивести_кд(М, "\"\р");
        статус_помилки = 1;
        стрибнути вихід_з_помилкою;
      }

      взяти_файл(
        М,
        абсолютний_шлях_до_файлу_модуля,
        назва_модуля,
        Місцезнаходження { абсолютний_шлях_до_файлу_модуля, 0 }
      );

      якщо отримати_інформацію_падіння(М, інформація_падіння::адреса) {
        надрукувати_інформацію_падіння(
          М,
          інформація_падіння
        );

        знищити_інформацію_падіння(М, інформація_падіння);

        статус_помилки = 1;
        стрибнути вихід_з_помилкою;
      }
    }

    вернути 0;

  вихід_з_помилкою:
    вернути статус_помилки;
  }
}