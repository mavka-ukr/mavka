взяти визначення мавка;

простір мавка {
  дія записати_дію__аввід__запитати(М: *Машина, предмет_модуля: *ПредметМодуля);

  дія створити_і_призначити_модуль_аввід(
    М: *Машина,
  ) {
    змінна модуль_аввід = створити_модуль(
      М,
      створити_текст(М, "аввід")
    );

    записати_дію__аввід__запитати(М, модуль_аввід);

    записати_в_середовище(
      М,
      М.глобальне_середовище,
      створити_текст(М, "аввід"),
      ПРЕДМЕТ(модуль_аввід)
    );
  }
}