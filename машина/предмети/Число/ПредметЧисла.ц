взяти визначення мавка;

внутрішня дія копіювати_памʼять<Т>(
  куди: *Т,
  звідки: *Т,
  кількість: природне
) {
  змінна п: природне = 0;

  поки п < кількість {
    куди[п] = звідки[п];

    п += 1;
  }
}

внутрішня дія заповнити_памʼять<Т>(
  куди: *Т,
  значення: Т,
  кількість: природне
) {
  змінна п: природне = 0;

  поки п < кількість {
    куди[п] = значення;

    п += 1;
  }
}

простір мавка {
  дія записати_дію_класу_Число__є_невизначеністю(М: *Машина);
  дія записати_метод_класу_Число__чародія_число(М: *Машина);
  дія записати_метод_класу_Число__чародія_текст(М: *Машина);

  дія заповнити_клас_Число(
    М: *Машина
  ) {
    М.клас_Число.вбудований = так;
    М.клас_Число.заборонити_наслідування = так;

    записати_дію_класу_Число__є_невизначеністю(М);
    записати_метод_класу_Число__чародія_число(М);
    записати_метод_класу_Число__чародія_текст(М);
  }

  дія здійснити_клас_числа(
    М: *Машина,
    задіяні: Задіяні,
    місцезнаходження: Місцезнаходження
  ) -> ЗначенняАбоСтанПадіння {
    змінна задіяне_значення: Значення = НЕДІЙСНЕ;

    знайти_задіяне(М, задіяні, 0, М.константи_назв._значення, задіяне_значення::адреса);

    вернути ЧИСЛО(отримати_число(М, задіяне_значення, місцезнаходження));
  }

  дія предмет_числа_отримати_властивість(
    М: *Машина,
    значення: р64,
    назва: *ПредметТексту,
    місцезнаходження: Місцезнаходження
  ) -> ЗначенняАбоСтанПадіння {
    змінна предмет_методу = знайти_метод_в_класі(
      М,
      М.клас_Число,
      назва
    );

    якщо предмет_методу == пусто {
      вернути НЕДІЙСНЕ;
    }

    вернути ПРЕДМЕТ(предмет_методу);
  }
}