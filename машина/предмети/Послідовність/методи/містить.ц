взяти визначення мавка;

простір мавка {
  внутрішня дія рідна_дія_методу_структури_Послідовність__містить(
    М: *Машина,
    діяльність: *Діяльність
  ) -> ЗначенняАбоСтанПадіння {
    якщо діяльність.здійснювач.вид != ЗПредмет {
      вернути ПАДІННЯ(М, створити_текст(М, "Неможливо здійснити дію послідовності \"містить\"."));
    }

    змінна предмет_послідовності = діяльність.здійснювач.дані як *Предмет як *ПредметПослідовності;

    якщо предмет_послідовності.клас != М.клас_Послідовність {
      вернути ПАДІННЯ(М, створити_текст(М, "Неможливо здійснити дію послідовності \"містить\"."));
    }

    змінна задіяне_значення = НЕДІЙСНЕ;

    знайти_задіяне(М, діяльність.задіяні, 0, М.константи_назв._значення, задіяне_значення::адреса);

    змінна п: природне = 0;

    поки п < предмет_послідовності.розмір {
      якщо порівняти_значення(М, предмет_послідовності.елементи[п], задіяне_значення) {
        вернути ДІЙСНЕ;
      }

      п += 1;
    }

    вернути НЕДІЙСНЕ;
  }

  дія записати_метод_класу_Послідовність__містить(
    М: *Машина
  ) {
    змінна предмет_дії = створити_рідну_дію(
      М,
      М.константи_назв._містить,
      М.пуста_послідовність,
      пусто,
      рідна_дія_методу_структури_Послідовність__містить,
      пусто
    );

    записати_метод_класу(
      М,
      М.клас_Послідовність,
      М.константи_назв._містить,
      предмет_дії
    );

    якщо М.стан_падіння {
      ЗАПАНІКУВАТИ(М, "Помилка при записі дії \"містить\" для структури \"Послідовність\".");
    }
  }
}