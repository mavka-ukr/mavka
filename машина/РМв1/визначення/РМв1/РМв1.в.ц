простір РМв1 {
  структура Значення {
    дані: р64 | природне | адреса;
    вид: п8;
  }

  структура Розширення;
  структура Діяльність;
  структура КористувацькіДані;
  структура Притримувач;

  структура Результат {
    значення: Значення;
    значення_помилки: Значення;
  }

  синонім ДіяПередЗнищеннямКористувацькихДаних = () -> ніщо;
  синонім РіднаДія = (Р: *Розширення, д: *Діяльність, р: *Результат) -> логічне;

  структура Розширення {
    М: адреса;
    надрукувати_кд: (я: *Я, значення: кд) -> ніщо;
    надрукувати_значення: (я: *Я, значення: Значення) -> ніщо;
    створити_притримувач: (я: *Я) -> *Притримувач;
    відпустити_притримувач: (я: *Я, притримувач: *Притримувач) -> ніщо;
    створити_користувацькі_дані: (я: *Я, дані: адреса, дія_перед_знищенням: ДіяПередЗнищеннямКористувацькихДаних) -> *КористувацькіДані;
    записати_користувацькі_дані_предмету: (я: *Я, значення: Значення, користувацькі_дані: *КористувацькіДані, р: *Результат) -> логічне;
    створити_число: (я: *Я, значення: р64, р: *Результат) -> логічне;
    створити_текст: (я: *Я, значення: кд, р: *Результат) -> логічне;
    створити_текст_без_копіювання: (я: *Я, значення: кд, р: *Результат) -> логічне;
    створити_дію: (я: *Я, назва: Значення, рідна_дія: РіднаДія, р: *Результат) -> логічне;
    створити_клас: (я: *Я, назва: Значення, предок: Значення, параметри: Значення, дії: Значення, р: *Результат) -> логічне;
    створити_модуль: (я: *Я, назва: Значення, р: *Результат) -> логічне;
    створити_список: (я: *Я, вмісткість: природне, р: *Результат) -> логічне;
    створити_словник: (я: *Я, р: *Результат) -> логічне;
    створити_дані: (я: *Я, дані: *п8, розмір: природне, р: *Результат) -> логічне;
    створити_дані_без_копіювання: (я: *Я, дані: *п8, розмір: природне, р: *Результат) -> логічне;
    здійснити: (я: *Я, значення: Значення, здійснювач: Значення, дз: *Значення, кз: природне, р: *Результат) -> логічне;
  }
}