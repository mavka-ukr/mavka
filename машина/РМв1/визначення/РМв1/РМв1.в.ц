простір РМв1 {
  структура Значення {
    дані: адреса | р64 | п64;
    вид: п8;
  }

  структура Розширення;
  структура Діяльність;
  структура КористувацькіДані;
  структура Притримувач;
  структура Притримане;

  структура Притримувач {
    Р: *Розширення;
    пм: адреса;
  }

  синонім ДіяПередЗнищеннямКористувацькихДаних = (Р: *Розширення, к: *КористувацькіДані) -> ніщо;
  синонім РіднаДія = (Р: *Розширення, д: *Діяльність, р: *Значення) -> логічне;

  структура КористувацькіДані {
    Р: *Розширення;
    км: адреса;
    значення: адреса;
    дія_перед_знищенням: ДіяПередЗнищеннямКористувацькихДаних;
  }

  структура Розширення {
    М: адреса;
    виділити_памʼять: (я: *Я, розмір: природне) -> адреса;
    перевиділити_памʼять: (я: *Я, значення: адреса, новий_розмір: природне) -> адреса;
    звільнити_памʼять: (я: *Я, значення: адреса) -> ніщо;
    недійсне: Значення;
    дійсне: Значення;
    надрукувати_кд: (я: *Я, значення: кд) -> ніщо;
    надрукувати_значення: (я: *Я, значення: Значення) -> ніщо;
    створити_притримувач: (я: *Я) -> *Притримувач;
    притримати: (я: *Я, притримувач: *Притримувач, значення: Значення) -> *Притримане;
    розпакувати_притримане: (я: *Я, притримане: *Притримане) -> Значення;
    знищити_притримувач: (я: *Я, притримувач: *Притримувач) -> ніщо;
    створити_користувацькі_дані: (я: *Я, дані: адреса, дія_перед_знищенням: ДіяПередЗнищеннямКористувацькихДаних) -> *КористувацькіДані;
    записати_користувацькі_дані_предмету: (я: *Я, значення: Значення, користувацькі_дані: *КористувацькіДані) -> логічне;
    створити_число: (я: *Я, значення: р64, рез: *Значення) -> логічне;
    створити_текст: (я: *Я, значення: кд, рез: *Значення) -> логічне;
    створити_текст_без_копіювання: (я: *Я, значення: кд, рез: *Значення) -> логічне;
    створити_дію: (я: *Я, назва: Значення, рідна_дія: РіднаДія, рез: *Значення) -> логічне;
    створити_клас: (я: *Я, назва: Значення, предок: Значення, параметри: Значення, дії: Значення, рез: *Значення) -> логічне;
    створити_модуль: (я: *Я, назва: Значення, рез: *Значення) -> логічне;
    створити_список: (я: *Я, вмісткість: природне, рез: *Значення) -> логічне;
    створити_словник: (я: *Я, рез: *Значення) -> логічне;
    створити_дані: (я: *Я, дані: *п8, розмір: природне, рез: *Значення) -> логічне;
    створити_дані_без_копіювання: (я: *Я, дані: *п8, розмір: природне, рез: *Значення) -> логічне;
    здійснити: (я: *Я, значення: Значення, здійснювач: Значення, дз: *Значення, кз: природне, рез: *Значення) -> логічне;
    вимкнути_стан_падіння: (я: *Я) -> ніщо;
    встановити_цикл_подій: (я: *Я, (Р: *Розширення) -> ціле) -> ніщо; // для бібліотеки
    встановити_взяти_біб: (я: *Я, (Р: *Розширення, довжина_шляху: природне, елементи_шляху: *кд, рез: *Значення) -> логічне) -> ніщо; // для бібліотеки
    встановити_користувацькі_дані: (я: *Я, користувацькі_дані: *КористувацькіДані) -> ніщо;


    внутрішня дія звільнити(я: *Я, значення: адреса) {
      я.звільнити_памʼять(значення);
    }

    внутрішня дія притримавши(я: *Я, притримувач: *Притримувач, значення: Значення) -> Значення {
      я.притримати(притримувач, значення);
      вернути значення;
    }
  }

  внутрішня дія виділити<Т>(Р: *Розширення, кількість: природне) -> *Т {
    вернути Р.виділити_памʼять(кількість * Т.розмір) як *Т;
  }

  внутрішня дія перевиділити<Т>(Р: *Розширення, значення: *Т, нова_кількість: природне) -> *Т {
    вернути Р.перевиділити_памʼять(значення, нова_кількість * Т.розмір) як *Т;
  }
}