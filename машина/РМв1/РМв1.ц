взяти визначення мавка;
взяти визначення РМв1;

простір мавка {
  структура КористувацькіДаніБібліотеки {
    Р: *РМв1::Розширення;
    внутрішні_користувацькі_дані: *РМв1::КористувацькіДані;
    взяти_біб: (Р: *РМв1::Розширення, довжина_шляху: природне, елементи_шляху: *кд, рез: *РМв1::Значення) -> логічне;
    цикл_подій: (Р: *РМв1::Розширення) -> ціле;
  }

  внутрішня дія ЗРЗМ(значення: РМв1::Значення) -> Значення {
    вернути Значення { значення.дані як п64, значення.вид };
  }

  внутрішня дія ЗМЗР(значення: Значення) -> РМв1::Значення {
    вернути РМв1::Значення { значення.дані як п64, значення.вид };
  }

  внутрішня дія рідна_дія_РМв1_виділити_памʼять(Р: *РМв1::Розширення, розмір: природне) -> адреса {
    вернути виділити<п8>(Р.М як *Машина, розмір) як адреса;
  }

  внутрішня дія рідна_дія_РМв1_перевиділити_памʼять(Р: *РМв1::Розширення, значення: адреса, новий_розмір: природне) -> адреса {
    вернути перевиділити<п8>(Р.М як *Машина, значення як *п8, новий_розмір) як адреса;
  }

  внутрішня дія рідна_дія_РМв1_звільнити_памʼять(Р: *РМв1::Розширення, значення: адреса) -> ніщо {
    звільнити(Р.М як *Машина, значення);
  }

  внутрішня дія рідна_дія_РМв1_надрукувати_кд(Р: *РМв1::Розширення, значення: кд) {
    надрукувати_кд(Р.М як *Машина, значення);
  }

  внутрішня дія рідна_дія_РМв1_надрукувати_значення(Р: *РМв1::Розширення, значення: РМв1::Значення) {
    надрукувати_значення(Р.М як *Машина, ЗРЗМ(значення), 0, 0);
  }

  внутрішня дія рідна_дія_РМв1_створити_притримувач(я: *РМв1::Розширення) -> *РМв1::Притримувач {
    стала М = я.М як *Машина;

    змінна п = виділити<РМв1::Притримувач>(М, 1);

    п.Р = я;
    п.пм = створити_притримувач(М);

    вернути п;
  }

  внутрішня дія рідна_дія_РМв1_притримати(Р: *РМв1::Розширення, притримувач: *РМв1::Притримувач, значення: РМв1::Значення) -> *РМв1::Притримане {
    стала М = Р.М як *Машина;
    змінна зм = ЗРЗМ(значення);
    якщо зм.вид != ЗПредмет {
      вернути пусто;
    }
    притримати(М, притримувач.пм як *Притримувач, зм.дані як *Предмет);
  }

  внутрішня дія рідна_дія_РМв1_розпакувати_притримане(Р: *РМв1::Розширення, притримане: *РМв1::Притримане) -> РМв1::Значення {
    стала М = Р.М як *Машина;
    вернути ЗМЗР(ПРЕДМЕТ((притримане як *Притриманий).предмет));
  }

  внутрішня дія рідна_дія_РМв1_знищити_притримувач(я: *РМв1::Розширення, притримувач: *РМв1::Притримувач) -> ніщо {
    стала М = я.М як *Машина;

    знищити_притримувач(М, притримувач.пм як *Притримувач);

    звільнити(М, притримувач);
  }

  внутрішня дія дія_перед_знищенням_користувацьких_даних_мавки(М: *Машина, користувацькі_дані: *КористувацькіДані) {
    змінна к = користувацькі_дані.значення як *РМв1::КористувацькіДані;

    к.дія_перед_знищенням(к.Р, к);

    звільнити(М, к);
  }

  внутрішня дія рідна_дія_РМв1_створити_користувацькі_дані(я: *РМв1::Розширення, дані: адреса, дія_перед_знищенням: РМв1::ДіяПередЗнищеннямКористувацькихДаних) -> *РМв1::КористувацькіДані {
    стала М = я.М як *Машина;

    змінна к = виділити<РМв1::КористувацькіДані>(М, 1);
    к.Р = я;
    к.км = створити_користувацькі_дані(М, к, дія_перед_знищенням_користувацьких_даних_мавки);
    к.значення = дані;
    к.дія_перед_знищенням = дія_перед_знищенням;

    вернути к;
  }

  внутрішня дія рідна_дія_РМв1_записати_користувацькі_дані_предмету(я: *РМв1::Розширення, значення: РМв1::Значення, користувацькі_дані: *РМв1::КористувацькіДані) -> логічне {
    змінна зм = ЗРЗМ(значення);

    якщо зм.вид != ЗПредмет {
      вернути ні;
    }

    змінна п = зм.дані як *Предмет;
    п.користувацькі_дані = користувацькі_дані.км як *КористувацькіДані;
  }

  внутрішня дія рідна_дія_РМв1_створити_число(я: *РМв1::Розширення, значення: р64, рез: *РМв1::Значення) -> логічне {
    рез::вміст = ЗМЗР(ЧИСЛО(значення));

    вернути так;
  }

  внутрішня дія рідна_дія_РМв1_створити_текст(я: *РМв1::Розширення, значення: кд, рез: *РМв1::Значення) -> логічне {
    рез::вміст = ЗМЗР(ПРЕДМЕТ(створити_текст(я.М як *Машина, значення)));

    вернути так;
  }

  внутрішня дія рідна_дія_РМв1_створити_текст_без_копіювання(я: *РМв1::Розширення, значення: кд, рез: *РМв1::Значення) -> логічне {
    рез::вміст = ЗМЗР(ПРЕДМЕТ(створити_текст_без_копіювання(
      я.М як *Машина,
      значення.розмір,
      значення.дані
    )));

    вернути так;
  }

  структура КДРДРМв1 {
    Р: *РМв1::Розширення;
    рідна_дія: РМв1::РіднаДія;
    додаткові_користувацькі_дані: *РМв1::КористувацькіДані;
  }

  внутрішня дія дія_перед_знищенням_КДРДРМв1(М: *Машина, користувацькі_дані: *КористувацькіДані) {
    змінна корд = користувацькі_дані.значення як *КДРДРМв1;

    якщо корд.додаткові_користувацькі_дані != пусто {
      // ...
    }

    звільнити(М, корд);
  }

  внутрішня дія рідна_дія_РМв1 (
    М: *Машина,
    діяльність: *Діяльність,
  ) -> ЗначенняАбоСтанПадіння {
    змінна дкд = діяльність.предмет_дії.додаткові_користувацькі_дані;
    якщо дкд == пусто {
      вернути НЕДІЙСНЕ; // щось пішло не так, вбудована помилка
    }

    змінна корд = дкд.значення як *КДРДРМв1;

    змінна рез: РМв1::Значення;

    змінна успіх = корд.рідна_дія(корд.Р, діяльність як *РМв1::Діяльність, рез::адреса);
    якщо не успіх {
      // потім: доробити
    }

    вернути НЕДІЙСНЕ;
  }

  внутрішня дія рідна_дія_РМв1_створити_дію(я: *РМв1::Розширення, назва: РМв1::Значення, рідна_дія: РМв1::РіднаДія, рез: *РМв1::Значення) -> логічне {
    стала М = я.М як *Машина;

    змінна назва_пт: *ПредметТексту = пусто;

    // потім: назва.дані як *Предмет як *ПредметТексту

    змінна д = створити_рідну_дію(
      М,
      назва_пт,
      М.пустий_список,
      пусто,
      рідна_дія_РМв1,
      пусто,
    );

    рез::вміст = ЗМЗР(ПРЕДМЕТ(д));

    змінна корд = виділити<КДРДРМв1>(М, 1);
    корд.Р = я;
    корд.рідна_дія = рідна_дія;
    корд.додаткові_користувацькі_дані = пусто;

    д.додаткові_користувацькі_дані = створити_користувацькі_дані(
      М,
      корд,
      дія_перед_знищенням_КДРДРМв1,
    );

    вернути так;
  }

  внутрішня дія рідна_дія_РМв1_створити_клас(я: *РМв1::Розширення, назва: РМв1::Значення, предок: РМв1::Значення, параметри: РМв1::Значення, дії: РМв1::Значення, рез: *РМв1::Значення) -> логічне {
  }

  внутрішня дія рідна_дія_РМв1_створити_модуль(я: *РМв1::Розширення, назва: РМв1::Значення, рез: *РМв1::Значення) -> логічне {
  }

  внутрішня дія рідна_дія_РМв1_створити_список(я: *РМв1::Розширення, вмісткість: природне, рез: *РМв1::Значення) -> логічне {
  }

  внутрішня дія рідна_дія_РМв1_створити_словник(я: *РМв1::Розширення, рез: *РМв1::Значення) -> логічне {
  }

  внутрішня дія рідна_дія_РМв1_створити_дані(я: *РМв1::Розширення, дані: *п8, розмір: природне, рез: *РМв1::Значення) -> логічне {
  }

  внутрішня дія рідна_дія_РМв1_створити_дані_без_копіювання(я: *РМв1::Розширення, дані: *п8, розмір: природне, рез: *РМв1::Значення) -> логічне {
  }

  внутрішня дія рідна_дія_РМв1_здійснити(я: *РМв1::Розширення, значення: РМв1::Значення, здійснювач: РМв1::Значення, дз: *РМв1::Значення, кз: природне, рез: *РМв1::Значення) -> логічне {
  }

  внутрішня дія рідна_дія_РМв1_вимкнути_стан_падіння(я: *РМв1::Розширення) {
  }

  внутрішня дія машина_цикл_подій(М: *Машина) -> ціле {
    якщо М.користувацькі_дані_бібліотеки == пусто {
      вернути 0;
    }

    змінна кдб = М.користувацькі_дані_бібліотеки.значення як *КористувацькіДаніБібліотеки;

    якщо кдб.цикл_подій == пусто {
      вернути 0;
    }

    вернути кдб.цикл_подій(кдб.Р);
  }

  внутрішня дія рідна_дія_РМв1_встановити_цикл_подій(я: *РМв1::Розширення, цикл_подій: (Р: *РМв1::Розширення) -> ціле) {
    стала М = я.М як *Машина;

    якщо М.користувацькі_дані_бібліотеки == пусто {
      // потім: помилка
    }

    змінна кдб = М.користувацькі_дані_бібліотеки.значення як *КористувацькіДаніБібліотеки;

    кдб.цикл_подій = цикл_подій;
  }

  внутрішня дія машина_взяти_біб(М: *Машина, довжина_шляху: природне, шлях: **ПредметТексту, місцезнаходження: Місцезнаходження) -> ЗначенняАбоСтанПадіння {
    якщо М.користувацькі_дані_бібліотеки == пусто {
      // потім: помилка
      вернути НЕДІЙСНЕ;
    }

    змінна кдб = М.користувацькі_дані_бібліотеки.значення як *КористувацькіДаніБібліотеки;
    змінна рез: РМв1::Значення;
    змінна успіх: логічне;
    змінна шлях_кд: *кд;
    змінна п: природне;

    шлях_кд = виділити<кд>(М, довжина_шляху);
    п = 0;
    поки п < довжина_шляху {
      шлях_кд[п] = шлях[п].значення;

      п += 1;
    }

    успіх = кдб.взяти_біб(кдб.Р, довжина_шляху, шлях_кд, рез::адреса);
    якщо не успіх {
      // потім: обробити
      вернути НЕДІЙСНЕ;
    }

    вернути ЗРЗМ(рез);
  }

  внутрішня дія рідна_дія_РМв1_встановити_взяти_біб(я: *РМв1::Розширення, взяти_біб: (Р: *РМв1::Розширення, довжина_шляху: природне, елементи_шляху: *кд, рез: *РМв1::Значення) -> логічне) {
    стала М = я.М як *Машина;

    якщо М.користувацькі_дані_бібліотеки == пусто {
      // потім: помилка
    }

    змінна кдб = М.користувацькі_дані_бібліотеки.значення як *КористувацькіДаніБібліотеки;

    кдб.взяти_біб = взяти_біб;
  }

  внутрішня дія рідна_дія_РМв1_встановити_користувацькі_дані(я: *РМв1::Розширення, користувацькі_дані: *РМв1::КористувацькіДані) {
    стала М = я.М як *Машина;

    якщо М.користувацькі_дані_бібліотеки == пусто {
      // потім: помилка
    }

    змінна кдб = М.користувацькі_дані_бібліотеки.значення як *КористувацькіДаніБібліотеки;

    кдб.внутрішні_користувацькі_дані = користувацькі_дані;
  }

  дія створити_РМв1(М: *Машина) -> *РМв1::Розширення {
    змінна Р = виділити<РМв1::Розширення>(М, 1);

    Р.М = М;
    Р.виділити_памʼять = рідна_дія_РМв1_виділити_памʼять;
    Р.перевиділити_памʼять = рідна_дія_РМв1_перевиділити_памʼять;
    Р.звільнити_памʼять = рідна_дія_РМв1_звільнити_памʼять;
    Р.недійсне = ЗМЗР(НЕДІЙСНЕ);
    Р.дійсне = ЗМЗР(ДІЙСНЕ);
    Р.надрукувати_кд = рідна_дія_РМв1_надрукувати_кд;
    Р.надрукувати_значення = рідна_дія_РМв1_надрукувати_значення;
    Р.створити_притримувач = рідна_дія_РМв1_створити_притримувач;
    Р.притримати = рідна_дія_РМв1_притримати;
    Р.розпакувати_притримане = рідна_дія_РМв1_розпакувати_притримане;
    Р.знищити_притримувач = рідна_дія_РМв1_знищити_притримувач;
    Р.створити_користувацькі_дані = рідна_дія_РМв1_створити_користувацькі_дані;
    Р.записати_користувацькі_дані_предмету = рідна_дія_РМв1_записати_користувацькі_дані_предмету;
    Р.створити_число = рідна_дія_РМв1_створити_число;
    Р.створити_текст = рідна_дія_РМв1_створити_текст;
    Р.створити_текст_без_копіювання = рідна_дія_РМв1_створити_текст_без_копіювання;
    Р.створити_дію = рідна_дія_РМв1_створити_дію;
    Р.створити_клас = рідна_дія_РМв1_створити_клас;
    Р.створити_модуль = рідна_дія_РМв1_створити_модуль;
    Р.створити_список = рідна_дія_РМв1_створити_список;
    Р.створити_словник = рідна_дія_РМв1_створити_словник;
    Р.створити_дані = рідна_дія_РМв1_створити_дані;
    Р.створити_дані_без_копіювання = рідна_дія_РМв1_створити_дані_без_копіювання;
    Р.здійснити = рідна_дія_РМв1_здійснити;
    Р.вимкнути_стан_падіння = рідна_дія_РМв1_вимкнути_стан_падіння;
    Р.встановити_цикл_подій = рідна_дія_РМв1_встановити_цикл_подій;
    Р.встановити_взяти_біб = рідна_дія_РМв1_встановити_взяти_біб;
    Р.встановити_користувацькі_дані = рідна_дія_РМв1_встановити_користувацькі_дані;

    вернути Р;
  }

  дія завантажити_РМв1(М: *Машина, шлях: *ПредметТексту, назва_символа: *ПредметТексту) -> ЗначенняАбоСтанПадіння {
    змінна Р = створити_РМв1(М);

    М.налаштування.завантажити_РМв1(М, Р, шлях, назва_символа);

    вернути НЕДІЙСНЕ;
  }

  внутрішня дія дія_перед_знищенням_кдб(М: *Машина, к: *КористувацькіДані) {
    змінна кдб = к.значення як *КористувацькіДаніБібліотеки;

    звільнити(М, кдб.Р);
    звільнити(М, кдб);
  }

  дія завантажити_РМв1_бібліотеки_мавки(М: *Машина, шлях: *ПредметТексту) -> ЗначенняАбоСтанПадіння {
    якщо М.користувацькі_дані_бібліотеки != пусто {
      // потім: помилка
      вернути НЕДІЙСНЕ;
    }

    змінна Р = створити_РМв1(М);

    змінна кдб = виділити<КористувацькіДаніБібліотеки>(М, 1);
    кдб.Р = Р;
    кдб.внутрішні_користувацькі_дані = пусто;
    кдб.взяти_біб = пусто;
    кдб.цикл_подій = пусто;

    М.користувацькі_дані_бібліотеки = створити_користувацькі_дані(
      М,
      кдб,
      дія_перед_знищенням_кдб,
    );

    М.налаштування.взяти_біб = машина_взяти_біб;
    М.цикл_подій = машина_цикл_подій;

    М.налаштування.завантажити_РМв1(М, Р, шлях, М.створити_текст("завантажити_РМв1_бібліотеки_мавки"));

    вернути НЕДІЙСНЕ;
  }
}