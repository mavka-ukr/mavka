взяти визначення КД;
взяти визначення мавка;
взяти визначення мавка/розбирач;

простір мавка {
  внутрішня дія КД_виділити_сиру_памʼять(система: *КД::Система, розмір: природне) -> *п8 {
    змінна М = система.дані як *Машина;
    вернути виділити<п8>(М, розмір);
  }

  внутрішня дія КД_перевиділити_сиру_памʼять(система: *КД::Система, значення: *п8, новий_розмір: природне) -> *п8 {
    змінна М = система.дані як *Машина;
    вернути перевиділити<п8>(М, значення, новий_розмір);
  }

  внутрішня дія КД_звільнити_сиру_памʼять(система: *КД::Система, значення: адреса) {
    змінна М = система.дані як *Машина;
    звільнити(М, значення);
  }

  дія перекодувати_ю8_в_кд(М: *Машина, значення: ю8, вихід: *кд, вихід_позиції_помилки: *природне) -> логічне {
    змінна система_КД = КД::Система {
      дані = М,
      виділити_сиру_памʼять = КД_виділити_сиру_памʼять,
      звільнити_сиру_памʼять = КД_звільнити_сиру_памʼять,
      перевиділити_сиру_памʼять = КД_перевиділити_сиру_памʼять
    };

    вернути КД::перекодувати_з_ю8(
      система_КД::адреса,
      значення,
      ні,
      так,
      вихід,
      вихід_позиції_помилки
    );
  }

  дія перекодувати_кд_в_ю8(М: *Машина, значення: кд, вихід: *ю8, вихід_позиції_помилки: *природне) -> логічне {
    змінна система_КД = КД::Система {
      дані = М,
      виділити_сиру_памʼять = КД_виділити_сиру_памʼять,
      звільнити_сиру_памʼять = КД_звільнити_сиру_памʼять,
      перевиділити_сиру_памʼять = КД_перевиділити_сиру_памʼять
    };

    вернути КД::перекодувати_в_ю8(
      система_КД::адреса,
      значення,
      так,
      вихід,
      вихід_позиції_помилки
    );
  }

  дія юнікс_отримати_шлях_до_паку_з_шляху_теки_модулів(
    М: *Машина,
    шлях_до_теки_модулів: *ПредметДаних,
    шлях_до_теки_паків: *ПредметДаних,
    вихід: **ПредметДаних
  ) -> логічне {
    змінна п: природне;
    змінна позиція_наступного_слешу: природне;
    змінна початок: природне;
    змінна знайдено: логічне;

    якщо шлях_до_теки_модулів.розмір <= шлях_до_теки_паків.розмір {
      вернути ні;
    }

    п = 0;
    поки п < шлях_до_теки_паків.розмір {
      якщо шлях_до_теки_модулів.дані[п] != шлях_до_теки_паків.дані[п] {
        вернути ні;
      }

      п += 1;
    }

    позиція_наступного_слешу = 0;
    знайдено = ні;

    початок = шлях_до_теки_паків.розмір;
    якщо початок < шлях_до_теки_модулів.розмір і шлях_до_теки_модулів.дані[початок] == АСКІ_СЛЕШ {
      початок += 1;
    }

    п = початок;
    поки п < шлях_до_теки_модулів.розмір {
      якщо шлях_до_теки_модулів.дані[п] == АСКІ_СЛЕШ {
        позиція_наступного_слешу = п;
        знайдено = так;
        стрибнути к1;
      }

      п += 1;
    }

  к1:
    якщо не знайдено {
      позиція_наступного_слешу = шлях_до_теки_модулів.розмір;
    }

    змінна розмір = позиція_наступного_слешу;
    змінна дані = виділити<п8>(М, розмір);
    якщо дані == пусто {
      вернути ні;
    }

    п = 0;
    поки п < позиція_наступного_слешу {
      дані[п] = шлях_до_теки_модулів.дані[п];

      п += 1;
    }

    вихід::вміст = створити_дані_без_копіювання(
      М,
      розмір,
      дані
    );

    вернути так;
  }

  дія юнікс_збити_шлях_до_модуля(
    М: *Машина,
    кількість_елементів: природне,
    елементи: **ПредметДаних,
    вихід: **ПредметДаних
  ) -> логічне {
    змінна п: природне;
    змінна суфікс = ю8".м";
    змінна загальний_розмір = (кількість_елементів) + суфікс.розмір;

    поки п < кількість_елементів {
      загальний_розмір += елементи[п].розмір;

      п += 1;
    }

    змінна дані = виділити<п8>(М, загальний_розмір);
    якщо дані == пусто {
      вернути ні;
    }

    змінна позиція: природне = 0;

    п = 0;
    поки п < кількість_елементів {
      змінна пп: природне = 0;
      поки пп < елементи[п].розмір {
        дані[позиція] = елементи[п].дані[пп];

        позиція += 1;
        пп += 1;
      }

      якщо п < (кількість_елементів - 1) {
        дані[позиція] = АСКІ_СЛЕШ;

        позиція += 1;
      }

      п += 1;
    }

    п = 0;
    поки п < суфікс.розмір {
      дані[позиція] = суфікс.дані[п];

      позиція += 1;

      п += 1;
    }

    вихід::вміст = створити_дані_без_копіювання(
      М,
      загальний_розмір,
      дані
    );

    вернути так;
  }

  дія юнікс_отримати_теку_файлу(
    М: *Машина,
    шлях_до_файлу: *ПредметДаних,
    глибина: природне
  ) -> *ПредметДаних {
    вернути шлях_до_файлу;
  }
}