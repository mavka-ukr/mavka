взяти визначення КД;
взяти визначення мавка;
взяти визначення мавка/пристрій;

дія почати(кількість_аргументів: природне, аргументи: *ю8) -> ц32 {
  змінна успіх: логічне;
  змінна статус_помилки: ціле;
  змінна п: природне;
  змінна М: *мавка::Машина;
  змінна текстові_аргументи: **мавка::ПредметТексту;

  якщо кількість_аргументів == 0 {
    змінна пом = ю8"кількість_аргументів == 0\р";
    пристрій_мавки_вивести_ю8(0, пом.дані, пом.розмір);
    вернути 1;
  }

  М = мавка::пристрій::створити_машину();
  мавка::пристрій::призначити_глобально_мавка(М);
  мавка::пристрій::призначити_глобальні_виводу(М);

  текстові_аргументи = мавка::виділити<*мавка::ПредметТексту>(М, кількість_аргументів);
  п = 0;
  поки п < кількість_аргументів {
    змінна значення_кд: кд;
    успіх = мавка::перекодувати_ю8_в_кд(
      М,
      аргументи[п],
      значення_кд::адреса,
      пусто,
    );
    якщо не успіх {
      статус_помилки = 1;
      стрибнути вихід;
    }

    текстові_аргументи[п] = М.створити_текст(значення_кд);

    п += 1;
  }

  статус_помилки = мавка::почати(
    М,
    кількість_аргументів,
    текстові_аргументи,
  );
  якщо статус_помилки {
    стрибнути вихід;
  }

  мавка::звільнити(М, текстові_аргументи);
  мавка::розлаштувати_машину(М);

вихід:
  вернути ц32(статус_помилки);
}