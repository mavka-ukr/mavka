  простір бібліотека {
    структура КористувацькіДаніБібліотекиМавки {
      взято__мат: *Притриманий; // ПредметМодуля
      взято__афс: *Притриманий; // ПредметМодуля
      взято__аввід: *Притриманий; // ПредметМодуля
      взято__інет: *Притриманий; // ПредметМодуля

      інет__КлієнтСлухача: *ПредметКласу;
    }

    дія ініціалізувати(М: *Машина);

    дія записати_дію__мат__син(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__мат__кос(М: *Машина, предмет_модуля: *ПредметМодуля);
