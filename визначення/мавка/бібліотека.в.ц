простір мавка {
  простір бібліотека {
    структура КористувацькіДаніБібліотекиМавки {
      взято__мат: *Притриманий; // ПредметМодуля
      взято__афс: *Притриманий; // ПредметМодуля
      взято__аввід: *Притриманий; // ПредметМодуля
      взято__інет: *Притриманий; // ПредметМодуля

      // ці притримувати не треба, так як вони є властивостями модулів вище
      інет__Слуга: *ПредметКласу;
      інет__Звʼязок: *ПредметКласу;
    }

    дія ініціалізувати(М: *Машина);

    дія записати_дію__мат__син(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__мат__кос(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__мат__тан(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__мат__асин(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__мат__акос(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__мат__атан(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__мат__абс(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__мат__експ(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__мат__кор2(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__мат__стеля(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__мат__підлога(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__мат__округлити(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія ініціалізувати__мат(М: *Машина, предмет_модуля: *ПредметМодуля);

    дія записати_дію__афс__видалити(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__афс__дописати(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__афс__записати(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__афс__прочитати(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__афс__створити_папку(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія ініціалізувати__афс(М: *Машина, предмет_модуля: *ПредметМодуля);

    дія записати_дію__аввід__запитати(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія ініціалізувати__аввід(М: *Машина, предмет_модуля: *ПредметМодуля);

    структура КористувацькіДаніІнетСлуги {
      адр_слуга: адреса;
    }
    структура КористувацькіДаніІнетЗвʼязку {
      адр_звʼязок: адреса;
    }
    дія отримати_текст_інет_помилки(М: *Машина, помилка: природне) -> *ПредметТексту;
    дія записати_клас__інет__Слуга(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_клас__інет__Звʼязок(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__інет__служити(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія записати_дію__інет__підключитись(М: *Машина, предмет_модуля: *ПредметМодуля);
    дія ініціалізувати__інет(М: *Машина, предмет_модуля: *ПредметМодуля);

    дія створити_дію__читати(М: *Машина) -> *ПредметДії;
  }
}