}

внутрішня дія машина_отримати_поточний_шлях_процесу(
  М: *мавка::Машина,
) -> *мавка::ПредметТексту {
  змінна шлях: кд;
  змінна успіх: логічне;

  успіх = пристрій_мавки_отримати_поточний_шлях_процесу(
    шлях.дані::адреса,
    шлях.розмір::адреса,
  );
  якщо не успіх {
    вернути пусто;
  }

  вернути мавка::створити_текст_без_копіювання(
    М,
    шлях.розмір,
    шлях.дані,
  );
}

структура ДаніЧитанняВводу {
  М: *мавка::Машина;
  перед: *мавка::ПредметТексту;
  обробник: мавка::ОбробникПрочитанняВводу;
  аргумент: адреса;
}

внутрішня дія обробник_прочитання(
  дані: *п8,
  розмір: природне,
  кінець_файлу: логічне,
  аргумент: адреса,
) {
  змінна успіх: логічне;
  змінна дчв = аргумент як *ДаніЧитанняВводу;
  змінна М = дчв.М;

  якщо кінець_файлу {
    дчв.обробник(
      кд { пусто, 0 },
      так,
      дчв.аргумент,
    );
  } інакше {
    дчв.обробник(
      кд { дані, розмір },
      ні,
      дчв.аргумент,
    );
  }

  мавка::звільнити(М, дчв);
}

внутрішня дія машина_читати_ввід_асинхронно(
  М: *мавка::Машина,
  перед: *мавка::ПредметТексту,
  обробник: мавка::ОбробникПрочитанняВводу,
  аргумент: адреса,
  дозволити_історію: логічне,
) {
  змінна успіх: логічне;

  змінна дчв = мавка::виділити<ДаніЧитанняВводу>(М, 1);
  дчв.М = М;
  дчв.перед = перед;
  дчв.обробник = обробник;
  дчв.аргумент = аргумент;

  пристрій_мавки_читати_асинхронно(
    перед.значення.дані,
    перед.значення.розмір,
    обробник_прочитання,
    дчв,
    дозволити_історію,
  );
}

внутрішня дія машина_перевірити_чи_шлях_існує_і_є_файлом(
