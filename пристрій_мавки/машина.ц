взяти визначення КД;
взяти визначення пристрій_мавки;

простір мавка {
  дія перетворити_п64_в_кд(
    М: *Машина,
    значення: п64,
    вихід_текстового_значення: *кд
  ) -> логічне {
    змінна значення_кд: кд;

    якщо пристрій_мавки_перетворити_п64_в_кд(значення, значення_кд.дані::адреса, значення_кд.розмір::адреса) {
      вихід_текстового_значення.розмір = значення_кд.розмір;
      вихід_текстового_значення.дані = значення_кд.дані;

      вернути так;
    }

    вернути ні;
  }

  дія перетворити_ц64_в_кд(
    М: *Машина,
    значення: ц64,
    вихід_текстового_значення: *кд
  ) -> логічне {
    змінна значення_кд: кд;

    якщо пристрій_мавки_перетворити_ц64_в_кд(значення, значення_кд.дані::адреса, значення_кд.розмір::адреса) {
      вихід_текстового_значення.розмір = значення_кд.розмір;
      вихід_текстового_значення.дані = значення_кд.дані;

      вернути так;
    }

    вернути ні;
  }

  дія перетворити_р64_в_кд(
    М: *Машина,
    значення: р64,
    вихід_текстового_значення: *кд
  ) -> логічне {
    змінна значення_кд: кд;

    якщо пристрій_мавки_перетворити_р64_в_кд(значення, значення_кд.дані::адреса, значення_кд.розмір::адреса) {
      вихід_текстового_значення.розмір = значення_кд.розмір;
      вихід_текстового_значення.дані = значення_кд.дані;

      вернути так;
    }

    вернути ні;
  }

  дія розібрати_число_з_кд(
    М: *Машина,
    значення: кд,
    вихід: *р64
  ) -> логічне {
    вернути пристрій_мавки_отримати_р64_з_кд(
      значення.дані,
      значення.розмір,
      вихід
    );
  }

  дія піднести_до_степеня_р64(
    М: *Машина,
    значення: р64,
    степінь: р64
  ) -> р64 {
    вернути пристрій_мавки_піднести_до_степеня_р64(
      значення,
      степінь
    );
  }
}

